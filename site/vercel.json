{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "sh build.sh dist https://via.computer https://made.via.computer",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path((?!_vercel/|api/|b/|u/)[^.]+)",
      "has": [
        {
          "type": "host",
          "value": "made.via.computer"
        }
      ],
      "destination": "https://via.computer/:path*",
      "permanent": false
    },
    {
      "source": "/made",
      "has": [
        {
          "type": "host",
          "value": "via.computer"
        }
      ],
      "destination": "https://made.via.computer/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
